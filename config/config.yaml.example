paths:
  processed_dir: ./data/processed
  merged_dir: ./data/merged
  results_dir: ./data/results
  reports_dir: ./data/reports
  graphs_dir: ./data/graphs
  log_dir: ./logs
  log_file: srf_postmortem.log
  watch_folders:
  - /mnt/w/
  - /mnt/x/
  - /mnt/y/
  append_dirs:
  - ./data/append/scope1
  - ./data/append/scope2
  - ./data/append/scope3
  graphs_db_dir: ./db/graphs
db:
  path: ./db/events.db
access:
  password: 'your_password_here'
  session_ttl_minutes: 60
web:
  host: 0.0.0.0
  port: 8050
  title: SRF Postmortem Viewer
  url_base: 'https://postmortem.pls-srf.org'
system:
  mode: batch
  check_interval: 1.0
email:
  smtp_server: smtp.gmail.com
  smtp_port: 587
  sender_email: your_email@gmail.com
  sender_password: 'your_app_password_here'
  receiver_emails:
  - recipient@example.com
  subject_template: SRF Event Report - {case}
classification:
  beam_min_v: 2.0
  dump_ratio: 0.5
  digital_min_persistence_ms: 0.01
  digital_delay_compensation_ms: 0.4
  simultaneous_window_ms: 0.01
  high_threshold: 1.2
  highhigh_threshold: 1.4
  low_threshold: 0.9
  lowlow_threshold: 0.5
  baseline_start_s: -0.5
  baseline_end_s: -0.45
  baseline_clip_v: 0.01
  search_start_s: -0.045
  search_end_s: 0.05
  # 인터록 극성: fault 는 '전이'이고, 어느 방향이 fault 인지는 채널마다 다르다.
  #   active_low  : 평상시 1(OK) -> 0 으로 떨어질 때 fault
  #   active_high : 평상시 0(OK) -> 1 로 올라갈 때 fault
  # 두 목록에 없는 채널은 active_high 로 간주하고 경고 로그를 남긴다.
  digital_active_low:
  - RDY_CM3_FC3_d
  - RDY_CM2_FC2_d
  - RDY_CM1_FC1_d
  - HE-PR_CM3_FC3_d
  - HE-PR_CM2_FC2_d
  - HE-PR_CM1_FC1_d
  - ARC_CM3_FC3_d
  - ARC_CM2_FC2_d
  - ARC_CM1_FC1_d
  - QUEN_CM3_FC3_d
  - QUEN_CM2_FC2_d
  - QUEN_CM1_FC1_d
  - VAC_CM3_FC3_d
  - VAC_CM2_FC2_d
  - VAC_CM1_FC1_d
  - INT_IN_FC3_d
  - INT_IC_FC2_d
  - INT_IC_FC1_d
  digital_active_high:
  - INT_MIS1_IC_d
  - INT_MIS2_IC_d
  - INT_PSI2_IC_d
  - INT_PSI1_IC_d
  - RDY_KSU3_IC_d
  - RDY_KSU2_IC_d
  - RDY_KSU1_IC_d
preprocessor:
  segment_pre_s: 0.05
  segment_post_s: 0.05
  decimation_factor: 2
  parquet_compression: zstd
grouper:
  window_s: 180.0
  wait_timeout: 300
  merge_strategy: full_join
visualization:
  analog_colors:
    B: '#FFE033'
    C: '#00D4FF'
    D: '#FF1E6B'
    E: '#96D800'
  figure_size:
  - 15
  - 8
  dpi: 150
report:
  include_sections:
  - event_summary
  - classification_result
  - signal_metrics
  - digital_events
  - recommended_actions
  - attachment_list
  output_format: markdown
  include_graphs: true
  include_raw_data: false
logging:
  level: INFO
  format: json
  rotation: daily
  retention_days: 30
  console_enabled: true
  file_enabled: true
monitor:
  data_root: /path/to/data
  merged_dir: merged
  graphs_dir: graphs
  reports_dir: reports
  scope_timeout: 120
