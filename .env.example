# Copy this file to .env (git-ignored) and fill in the OpenRouter key.
# .env itself must never be committed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

RAG_DB_PATH=db/events.db
RAG_INDEX_PATH=data/rag/rag.sqlite3
RAG_TOP_K=8
RAG_MAX_TOKENS=1500
RAG_TEMPERATURE=0.0
RAG_REQUEST_TIMEOUT=120
# RAG_REASONING_EFFORT=low

# --- MCP server (scripts/run_mcp.py) ---
# IP allowlist: requests outside these CIDRs get 403.
MCP_ALLOWED_CIDRS=141.223.105.0/24,127.0.0.1/32,::1/128
# Direct (non-proxied) clients in these CIDRs may use /mcp without credentials.
# Leave empty to require auth everywhere. Proxied requests (Cloudflare Tunnel,
# X-Forwarded-For, ...) always require credentials.
MCP_PASSWORDLESS_CIDRS=141.223.105.0/24
# Credentials for everything else.
MCP_BEARER_TOKEN=
MCP_ACCESS_PASSWORD=
